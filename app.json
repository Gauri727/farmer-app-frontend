{
  "expo": {
    "name": "farmer-app",
    "slug": "farmer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF7EE"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#EAF7EE"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/icon.png"
    },

    "plugins": [
      "expo-secure-store"
    ]
  }
}
